<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Production</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: { 400: '#748ffc', 500: '#5c7cfa', 600: '#4c6ef5', 700: '#4263eb' },
            surface: {
              500: '#adb5bd', 600: '#868e96', 700: '#495057', 800: '#343a40',
              900: '#212529', 950: '#0d1117'
            }
          }
        }
      }
    };
  </script>
  <style>
    body { background-color: #0d1117; color: #e6edf3; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    .glass-card { background: rgba(22, 27, 34, 0.6); border: 1px solid rgba(48, 54, 61, 0.4); }
    .btn-primary { background: linear-gradient(135deg, #4c6ef5, #3b5bdb); transition: all .2s ease; }
    .btn-primary:hover { background: linear-gradient(135deg, #5c7cfa, #4263eb); box-shadow: 0 4px 15px rgba(76, 110, 245, .4); }
  </style>
</head>
<body class="min-h-screen antialiased">
  <div class="max-w-5xl mx-auto px-6 py-10">
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center">
          <i class="fa-solid fa-tower-broadcast text-white text-sm"></i>
        </div>
        <span class="text-lg font-bold" style="background:linear-gradient(135deg,#748ffc,#5c7cfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Production</span>
      </div>
      <a href="<%= websiteUrl %>/teams/<%= team.id %>" class="text-sm text-surface-500 hover:text-white">
        <i class="fa-solid fa-arrow-left mr-1"></i> Back to <%= team.name %>
      </a>
    </div>

    <% if (success) { %>
      <div class="bg-green-500/10 border border-green-500/30 rounded-xl px-4 py-3 mb-6 text-green-400 text-sm">
        <i class="fa-solid fa-check-circle mr-2"></i>Subscription activated! Your plan is now active.
      </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      <div class="lg:col-span-2 glass-card rounded-xl p-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h1 class="text-2xl font-bold"><%= plan.name %> Plan</h1>
            <p class="text-surface-500 text-sm"><%= plan.blurb %></p>
          </div>
          <div class="text-right">
            <p class="text-2xl font-bold"><%= plan.priceLabel %></p>
            <p class="text-xs text-surface-500">per month</p>
            <% if (!active) { %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-surface-800 text-surface-400 mt-1 inline-block">Not subscribed</span>
            <% } else if (sub.status === 'trialing') { %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 mt-1 inline-block">Trial</span>
            <% } else { %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-green-500/20 text-green-400 mt-1 inline-block">Active</span>
            <% } %>
          </div>
        </div>

        <h2 class="text-sm font-semibold text-surface-400 uppercase tracking-wider mb-3">Usage</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <% ['teams', 'members', 'obsConnections'].forEach(resource => { %>
            <% const max = plan.limits[resource]; %>
            <div class="rounded-lg bg-surface-900/60 border border-surface-700/60 p-4">
              <p class="text-xs text-surface-500 mb-1"><%= resource === 'obsConnections' ? 'OBS Connections' : resource.charAt(0).toUpperCase() + resource.slice(1) %></p>
              <p class="text-xl font-bold"><%= usage[resource] %> <span class="text-surface-600 text-sm">/ <%= max === Infinity ? 'Unlimited' : max %></span></p>
            </div>
          <% }) %>
        </div>

        <h2 class="text-sm font-semibold text-surface-400 uppercase tracking-wider mb-3">Plan features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <% plan.features.forEach(f => { %>
            <li class="flex items-start gap-2 text-sm">
              <i class="fa-solid fa-check text-green-400 mt-0.5"></i>
              <span class="text-surface-300"><%= f %></span>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="space-y-4">
        <div class="glass-card rounded-xl p-5">
          <h2 class="text-lg font-semibold mb-3">Manage subscription</h2>
          <% if (hasPortal) { %>
            <form method="POST" action="/api/portal">
              <input type="hidden" name="team" value="<%= team.id %>">
              <button type="submit" class="btn-primary w-full px-4 py-2.5 rounded-xl text-white text-sm font-medium">
                <i class="fa-solid fa-credit-card mr-1"></i> Manage billing
              </button>
            </form>
            <p class="text-xs text-surface-500 mt-3">Invoices, payment methods, and cancel/upgrade are handled by Stripe's billing portal.</p>
          <% } else { %>
            <p class="text-sm text-surface-500 mb-3">No active subscription. Choose a plan to get started.</p>
            <a href="<%= checkoutUrl %>/?team=<%= team.id %>&plan=creator" class="btn-primary w-full inline-block text-center px-4 py-2.5 rounded-xl text-white text-sm font-medium">
              Subscribe now
            </a>
          <% } %>
        </div>

        <div class="glass-card rounded-xl p-5">
          <h2 class="text-lg font-semibold mb-3">Change plan</h2>
          <div class="space-y-2">
            <% allPlans.forEach(p => { %>
              <a href="<%= checkoutUrl %>/?team=<%= team.id %>&plan=<%= p.key %>"
                class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-surface-800/60 transition-colors <%= p.key === planKey ? 'ring-1 ring-brand-500' : '' %>">
                <span class="text-sm font-medium"><%= p.name %></span>
                <span class="text-xs text-surface-500"><%= p.priceLabel %>/mo</span>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
