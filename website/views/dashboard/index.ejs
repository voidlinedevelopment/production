<div class="max-w-7xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold">Welcome back, <%= user.global_name || user.username %></h1>
      <p class="text-surface-400 mt-1">Here's what's happening with your productions.</p>
    </div>
    <a href="/teams/create" class="btn-primary inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-white text-sm font-medium">
      <i class="fas fa-plus"></i>
      New Team
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
    <div class="glass-card rounded-xl p-5">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded-lg bg-blue-500/15 flex items-center justify-center">
          <i class="fas fa-users text-blue-400"></i>
        </div>
        <div>
          <p class="text-2xl font-bold"><%= totalTeams %></p>
          <p class="text-xs text-surface-500">Teams</p>
        </div>
      </div>
    </div>
    <div class="glass-card rounded-xl p-5">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded-lg bg-red-500/15 flex items-center justify-center">
          <i class="fas fa-broadcast-tower text-red-400"></i>
        </div>
        <div>
          <p class="text-2xl font-bold"><%= totalProductions %></p>
          <p class="text-xs text-surface-500">Live Productions</p>
        </div>
      </div>
    </div>
    <div class="glass-card rounded-xl p-5">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded-lg bg-green-500/15 flex items-center justify-center">
          <i class="fas fa-check-circle text-green-400"></i>
        </div>
        <div>
          <p class="text-2xl font-bold">Online</p>
          <p class="text-xs text-surface-500">Status</p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div>
      <h2 class="text-lg font-semibold mb-4">Your Teams</h2>
      <% if (teams.length === 0) { %>
        <div class="glass-card rounded-xl p-8 text-center">
          <i class="fas fa-users text-surface-600 text-3xl mb-3"></i>
          <p class="text-surface-400 mb-4">You don't have any teams yet.</p>
          <a href="/teams/create" class="btn-primary inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm font-medium">
            <i class="fas fa-plus"></i> Create Your First Team
          </a>
        </div>
      <% } else { %>
        <div class="space-y-3">
          <% teams.forEach(team => { %>
            <a href="/teams/<%= team.id %>" class="glass-card rounded-xl p-4 flex items-center gap-4 block">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center flex-shrink-0">
                <% if (team.logo) { %>
                  <img src="<%= team.logo %>" alt="" class="w-12 h-12 rounded-xl object-cover">
                <% } else { %>
                  <span class="text-white font-bold text-lg"><%= team.name.charAt(0).toUpperCase() %></span>
                <% } %>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold truncate"><%= team.name %></h3>
                <p class="text-sm text-surface-500 truncate"><%= team.description || 'No description' %></p>
              </div>
              <i class="fas fa-chevron-right text-surface-600"></i>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div>
      <h2 class="text-lg font-semibold mb-4">Active Productions</h2>
      <% if (activeProductions.length === 0) { %>
        <div class="glass-card rounded-xl p-8 text-center">
          <i class="fas fa-video text-surface-600 text-3xl mb-3"></i>
          <p class="text-surface-400">No active productions right now.</p>
        </div>
      <% } else { %>
        <div class="space-y-3">
          <% activeProductions.forEach(prod => { %>
            <a href="/productions/<%= prod.team_id %>/<%= prod.id %>" class="glass-card rounded-xl p-4 block">
              <div class="flex items-center gap-3">
                <div class="status-dot status-live"></div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold truncate"><%= prod.name %></h3>
                  <p class="text-sm text-surface-500"><%= prod.team_name %></p>
                </div>
                <span class="px-2 py-0.5 rounded-full bg-red-500/20 text-red-400 text-xs font-medium">LIVE</span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>

      <h2 class="text-lg font-semibold mb-4 mt-8">Recent Activity</h2>
      <% if (recentActivity.length === 0) { %>
        <div class="glass-card rounded-xl p-8 text-center">
          <i class="fas fa-clock text-surface-600 text-3xl mb-3"></i>
          <p class="text-surface-400">No recent activity.</p>
        </div>
      <% } else { %>
        <div class="space-y-2">
          <% recentActivity.forEach(activity => { %>
            <div class="glass-card rounded-lg px-4 py-3 flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-surface-800 flex items-center justify-center flex-shrink-0">
                <% if (activity.avatar) { %>
                  <img src="https://cdn.discordapp.com/avatars/<%= activity.user_id %>/<%= activity.avatar %>.png?size=32" alt="" class="w-8 h-8 rounded-full">
                <% } else { %>
                  <i class="fas fa-user text-surface-500 text-xs"></i>
                <% } %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm truncate"><%= activity.action %></p>
                <p class="text-xs text-surface-600"><%= activity.team_name || '' %></p>
              </div>
              <span class="text-xs text-surface-600 flex-shrink-0">
                <%= new Date(activity.created_at).toLocaleDateString() %>
              </span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>
