<div class="max-w-5xl mx-auto">
  <div class="mb-8">
    <a href="/teams/<%= team.id %>" class="text-surface-400 hover:text-white text-sm inline-flex items-center gap-1 mb-4">
      <i class="fas fa-arrow-left"></i> Back to Team
    </a>
    <h1 class="text-2xl font-bold">Roles & Permissions</h1>
    <p class="text-surface-400 mt-1">Manage roles and their permissions for <%= team.name %></p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="rounded-xl p-4 mb-6 border border-red-500/30 bg-red-500/10 text-red-300 text-sm">
      <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
    </div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="rounded-xl p-4 mb-6 border border-green-500/30 bg-green-500/10 text-green-300 text-sm">
      <i class="fas fa-check-circle mr-2"></i><%= success %>
    </div>
  <% } %>

  <div class="glass-card rounded-xl p-5 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold">Role Templates</h2>
      <% if (!templateOk) { %>
        <span class="text-xs px-2 py-0.5 rounded-full bg-surface-700 text-surface-400">Studio+ feature</span>
      <% } %>
    </div>
    <% if (templates.length > 0) { %>
      <div class="flex flex-wrap gap-2 mb-4">
        <% templates.forEach(tpl => { %>
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-800 text-sm">
            <i class="fas fa-copy text-brand-400 text-xs"></i><%= tpl.name %>
            <span class="text-xs text-surface-500">(<%= tpl.permissionCount %> perms)</span>
            <form method="POST" action="/roles/<%= team.id %>/templates/<%= tpl.id %>/delete" class="inline">
              <button type="submit" class="p-1 rounded hover:bg-red-500/15 text-surface-600 hover:text-red-400 transition-colors">
                <i class="fas fa-times text-xs"></i>
              </button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
    <p class="text-xs text-surface-600 mb-3">Save a role's permission setup as a reusable template, then apply it to any role below.<% if (!templateOk) { %> Available on Studio+.<% } %></p>
  </div>

  <div class="glass-card rounded-xl p-5 mb-6">
    <h2 class="text-lg font-semibold mb-4">Create Role</h2>
    <form method="POST" action="/roles/<%= team.id %>/create" class="flex gap-3">
      <input type="text" name="name" required placeholder="Role name..." maxlength="50"
        class="flex-1 bg-surface-900 border border-surface-700 rounded-lg px-4 py-2.5 text-white placeholder-surface-600 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors">
      <button type="submit" class="btn-primary px-5 py-2.5 rounded-xl text-white font-medium text-sm whitespace-nowrap">
        <i class="fas fa-plus mr-2"></i>Create
      </button>
    </form>
  </div>

  <div class="space-y-5">
    <% roles.forEach(role => { %>
      <div class="glass-card rounded-xl p-5">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-brand-600/20 flex items-center justify-center">
              <i class="fas fa-shield-alt text-brand-400"></i>
            </div>
            <div>
              <h3 class="font-semibold"><%= role.name %></h3>
              <p class="text-xs text-surface-500"><%= role.permissions.length %> permissions</p>
            </div>
          </div>
          <% if (role.name !== 'Owner') { %>
            <div class="flex items-center gap-1">
              <form method="POST" action="/roles/<%= team.id %>/<%= role.id %>/save-template">
                <input type="text" name="name" placeholder="Template name" <%= templateOk ? '' : 'disabled' %>
                  class="bg-surface-900 border border-surface-700 rounded-lg px-2 py-1 text-xs text-white placeholder-surface-600 focus:outline-none focus:border-brand-500">
                <button type="submit" <%= templateOk ? '' : 'disabled' %> class="px-2 py-1 rounded-lg hover:bg-surface-700 text-surface-400 text-xs transition-colors">
                  <i class="fas fa-copy"></i>
                </button>
              </form>
              <form method="POST" action="/roles/<%= team.id %>/<%= role.id %>/delete" onsubmit="return confirm('Delete this role?')">
                <button type="submit" class="p-2 rounded-lg hover:bg-red-500/15 text-surface-500 hover:text-red-400 transition-colors">
                  <i class="fas fa-trash text-sm"></i>
                </button>
              </form>
            </div>
          <% } %>
        </div>

        <% if (templateOk && templates.length > 0) { %>
          <div class="mb-4">
            <form method="POST" action="/roles/<%= team.id %>/<%= role.id %>/apply-template" class="flex items-center gap-2">
              <span class="text-xs text-surface-500">Apply template:</span>
              <select name="templateId" class="bg-surface-900 border border-surface-700 rounded-lg px-2 py-1 text-xs text-white focus:outline-none focus:border-brand-500">
                <% templates.forEach(tpl => { %>
                  <option value="<%= tpl.id %>"><%= tpl.name %></option>
                <% }) %>
              </select>
              <button type="submit" class="px-2 py-1 rounded-lg bg-surface-800 hover:bg-surface-700 text-xs transition-colors">
                <i class="fas fa-wand-magic-sparkles mr-1"></i>Apply
              </button>
            </form>
          </div>
        <% } %>

        <form method="POST" action="/roles/<%= team.id %>/<%= role.id %>/permissions">
          <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
            <% allPermissions.forEach(perm => { %>
              <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-surface-800/50 cursor-pointer transition-colors">
                <input type="checkbox" name="permissions" value="<%= perm.id %>"
                  <%= role.permissions.find(p => p.id === perm.id) ? 'checked' : '' %>
                  class="w-4 h-4 rounded border-surface-600 bg-surface-900 text-brand-500 focus:ring-brand-500 focus:ring-offset-0">
                <span class="text-sm text-surface-300"><%= perm.name %></span>
              </label>
            <% }) %>
          </div>
          <div class="mt-4">
            <button type="submit" class="px-4 py-2 rounded-lg bg-surface-800 hover:bg-surface-700 text-sm font-medium transition-colors">
              <i class="fas fa-save mr-1"></i> Save Permissions
            </button>
          </div>
        </form>
      </div>
    <% }) %>
  </div>
</div>
