<div class="max-w-2xl mx-auto">
  <div class="mb-8">
    <a href="/productions/<%= team.id %>" class="text-surface-400 hover:text-white text-sm inline-flex items-center gap-1 mb-4">
      <i class="fas fa-arrow-left"></i> Back to Productions
    </a>
    <h1 class="text-2xl font-bold">Create Production</h1>
    <p class="text-surface-400 mt-1">Set up a new live production event.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-500/10 border border-red-500/30 rounded-xl px-4 py-3 mb-6 text-red-400 text-sm">
      <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
    </div>
  <% } %>

  <form method="POST" action="/productions/<%= team.id %>/create" class="glass-card rounded-xl p-6 space-y-5">
    <div>
      <label class="block text-sm font-medium text-surface-300 mb-2">Production Name</label>
      <input type="text" name="name" required maxlength="200" placeholder="Friday Night Stream"
        class="w-full bg-surface-900 border border-surface-700 rounded-lg px-4 py-2.5 text-white placeholder-surface-600 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors">
    </div>
    <div>
      <label class="block text-sm font-medium text-surface-300 mb-2">Description</label>
      <textarea name="description" rows="3" maxlength="1000" placeholder="Describe this production..."
        class="w-full bg-surface-900 border border-surface-700 rounded-lg px-4 py-2.5 text-white placeholder-surface-600 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors resize-none"></textarea>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-surface-300 mb-2">Start Time</label>
        <input type="datetime-local" name="start_time"
          class="w-full bg-surface-900 border border-surface-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors">
      </div>
      <div>
        <label class="block text-sm font-medium text-surface-300 mb-2">End Time</label>
        <input type="datetime-local" name="end_time"
          class="w-full bg-surface-900 border border-surface-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors">
      </div>
    </div>
    <div>
      <div class="flex items-center justify-between mb-2">
        <label class="block text-sm font-medium text-surface-300">Start from Template</label>
        <% if (!templatesOk) { %>
          <span class="text-xs px-2 py-0.5 rounded-full bg-surface-700 text-surface-400">Studio+ feature</span>
        <% } %>
      </div>
      <% if (templates.length > 0) { %>
        <select name="template_id"
          class="w-full bg-surface-900 border border-surface-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors">
          <option value="">No template (blank rundown)</option>
          <% templates.forEach(tpl => { %>
            <option value="<%= tpl.id %>"><%= tpl.name %></option>
          <% }) %>
        </select>
      <% } else { %>
        <p class="text-xs text-surface-600">No templates yet. Open a production and click "Save as Template" to create one.<% if (!templatesOk) { %> Requires Studio+.<% } %></p>
      <% } %>
    </div>
    <div class="flex items-center gap-3 pt-2">
      <button type="submit" class="btn-primary px-6 py-2.5 rounded-xl text-white font-medium text-sm">
        <i class="fas fa-plus mr-2"></i>Create Production
      </button>
      <a href="/productions/<%= team.id %>" class="px-6 py-2.5 rounded-xl text-surface-400 hover:text-white font-medium text-sm transition-colors">
        Cancel
      </a>
    </div>
  </form>
</div>
