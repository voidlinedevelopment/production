<div class="max-w-4xl mx-auto">
  <div class="mb-8">
    <a href="/teams/<%= team.id %>" class="text-surface-400 hover:text-white text-sm inline-flex items-center gap-1 mb-4">
      <i class="fas fa-arrow-left"></i> Back to Team
    </a>
    <h1 class="text-2xl font-bold">Team Activity Log</h1>
    <p class="text-surface-400 mt-1">Audit trail of everything that happens in this team.</p>
  </div>

  <% if (activity.length === 0) { %>
    <div class="glass-card rounded-xl p-8 text-center">
      <i class="fas fa-clipboard-list text-surface-600 text-3xl mb-3"></i>
      <p class="text-surface-400">No activity recorded yet.</p>
    </div>
  <% } else { %>
    <div class="glass-card rounded-xl p-5">
      <div class="space-y-1">
        <% activity.forEach(item => { %>
          <div class="flex items-center gap-3 py-2.5 border-b border-surface-800/40 last:border-0">
            <% if (item.avatar) { %>
              <img src="https://cdn.discordapp.com/avatars/<%= item.discord_id %>/<%= item.avatar %>.png?size=32" alt="" class="w-7 h-7 rounded-full flex-shrink-0">
            <% } else { %>
              <div class="w-7 h-7 rounded-full bg-surface-700 flex items-center justify-center text-xs font-bold flex-shrink-0">
                <%= (item.global_name || item.username || 'U').charAt(0).toUpperCase() %>
              </div>
            <% } %>
            <div class="flex-1 min-w-0">
              <p class="text-sm"><%= item.action %></p>
              <p class="text-xs text-surface-600"><%= item.global_name || item.username || 'System' %><%= item.details ? ' - ' + item.details : '' %></p>
            </div>
            <span class="text-xs text-surface-600 flex-shrink-0">
              <%= new Date(item.created_at).toLocaleString() %>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>
