<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | Production' : 'Production' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f4ff',
              100: '#dbe4ff',
              200: '#bac8ff',
              300: '#91a7ff',
              400: '#748ffc',
              500: '#5c7cfa',
              600: '#4c6ef5',
              700: '#4263eb',
              800: '#3b5bdb',
              900: '#364fc7',
              950: '#1a1a2e'
            },
            surface: {
              50: '#f8f9fa',
              100: '#f1f3f5',
              200: '#e9ecef',
              300: '#dee2e6',
              400: '#ced4da',
              500: '#adb5bd',
              600: '#868e96',
              700: '#495057',
              800: '#343a40',
              900: '#212529',
              950: '#0d1117'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    body { background-color: #0d1117; color: #e6edf3; }
    .glass { background: rgba(22, 27, 34, 0.8); backdrop-filter: blur(12px); border: 1px solid rgba(48, 54, 61, 0.6); }
    .glass-card { background: rgba(22, 27, 34, 0.6); backdrop-filter: blur(8px); border: 1px solid rgba(48, 54, 61, 0.4); transition: all 0.2s ease; }
    .glass-card:hover { border-color: rgba(76, 110, 245, 0.4); transform: translateY(-1px); }
    .btn-primary { background: linear-gradient(135deg, #4c6ef5, #3b5bdb); transition: all 0.2s ease; }
    .btn-primary:hover { background: linear-gradient(135deg, #5c7cfa, #4263eb); box-shadow: 0 4px 15px rgba(76, 110, 245, 0.4); }
    .sidebar-link { transition: all 0.15s ease; }
    .sidebar-link:hover, .sidebar-link.active { background: rgba(76, 110, 245, 0.15); color: #748ffc; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; }
    .status-online { background: #40c057; box-shadow: 0 0 6px rgba(64, 192, 87, 0.5); }
    .status-offline { background: #868e96; }
    .status-live { background: #fa5252; box-shadow: 0 0 6px rgba(250, 82, 82, 0.5); animation: pulse 2s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    .scrollbar-thin::-webkit-scrollbar { width: 6px; }
    .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: #343a40; border-radius: 3px; }
    .gradient-text { background: linear-gradient(135deg, #748ffc, #5c7cfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  </style>
</head>
<body class="min-h-screen font-sans antialiased">
  <% if (user) { %>
  <div class="flex min-h-screen">
    <aside class="w-64 glass border-r border-surface-700/50 flex flex-col fixed h-full z-30">
      <div class="p-5 border-b border-surface-700/50">
        <a href="/dashboard" class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center">
            <i class="fas fa-tower-broadcast text-white text-sm"></i>
          </div>
          <span class="text-lg font-bold gradient-text">Production</span>
        </a>
      </div>
      <nav class="flex-1 p-3 space-y-1 scrollbar-thin overflow-y-auto">
        <a href="/dashboard" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-surface-400 <%= currentPath === '/dashboard' ? 'active' : '' %>">
          <i class="fas fa-th-large w-5 text-center"></i>
          <span>Dashboard</span>
        </a>
        <a href="/teams" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-surface-400 <%= currentPath.startsWith('/teams') ? 'active' : '' %>">
          <i class="fas fa-users w-5 text-center"></i>
          <span>Teams</span>
        </a>
        <div class="pt-3 pb-1 px-3">
          <p class="text-xs font-semibold text-surface-600 uppercase tracking-wider">Quick Access</p>
        </div>
        <a href="/productions" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-surface-400 <%= currentPath.startsWith('/productions') ? 'active' : '' %>">
          <i class="fas fa-video w-5 text-center"></i>
          <span>Productions</span>
        </a>
        <a href="/obs" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-surface-400 <%= currentPath.startsWith('/obs') ? 'active' : '' %>">
          <i class="fas fa-desktop w-5 text-center"></i>
          <span>OBS Control</span>
        </a>
        <% if (user.is_admin) { %>
          <a href="<%= adminUrl %>" target="_blank" rel="noopener" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-yellow-400/90">
            <i class="fas fa-shield-alt w-5 text-center"></i>
            <span>Admin</span>
          </a>
        <% } %>
        <div class="pt-3 pb-1 px-3">
          <p class="text-xs font-semibold text-surface-600 uppercase tracking-wider">Resources</p>
        </div>
        <a href="<%= billingUrl %>" target="_blank" rel="noopener" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-surface-400">
          <i class="fas fa-credit-card w-5 text-center"></i>
          <span>Billing</span>
        </a>
        <a href="<%= supportUrl %>" target="_blank" rel="noopener" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-surface-400">
          <i class="fas fa-life-ring w-5 text-center"></i>
          <span>Support</span>
        </a>
      </nav>
      <div class="p-3 border-t border-surface-700/50">
        <div class="flex items-center gap-3 px-3 py-2">
          <% if (user.avatar) { %>
            <img src="https://cdn.discordapp.com/avatars/<%= user.discord_id %>/<%= user.avatar %>.png?size=64" alt="" class="w-8 h-8 rounded-full">
          <% } else { %>
            <div class="w-8 h-8 rounded-full bg-brand-600 flex items-center justify-center text-white text-sm font-bold">
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
          <% } %>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= user.global_name || user.username %></p>
            <p class="text-xs text-surface-500 truncate">@<%= user.username %></p>
          </div>
          <a href="/auth/logout" class="text-surface-500 hover:text-red-400 transition-colors" title="Logout">
            <i class="fas fa-sign-out-alt"></i>
          </a>
        </div>
      </div>
    </aside>
    <main class="flex-1 ml-64 p-6">
      <%- body %>
    </main>
  </div>
  <% } else { %>
    <%- body %>
  <% } %>
  <script src="/js/app.js"></script>
</body>
</html>
