<div class="max-w-7xl mx-auto">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Admin Dashboard</h1>
    <p class="text-surface-400 mt-1">Platform overview and management tools.</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
    <% const stats = [
      { label: 'Users', value: counts.userCount, icon: 'fa-users', color: 'text-blue-400 bg-blue-500/15' },
      { label: 'Teams', value: counts.teamCount, icon: 'fa-people-group', color: 'text-purple-400 bg-purple-500/15' },
      { label: 'Productions', value: counts.prodCount, icon: 'fa-video', color: 'text-green-400 bg-green-500/15' },
      { label: 'Live Now', value: counts.liveCount, icon: 'fa-broadcast-tower', color: 'text-red-400 bg-red-500/15' },
      { label: 'Active Subs', value: counts.subCount, icon: 'fa-credit-card', color: 'text-yellow-400 bg-yellow-500/15' },
      { label: 'Open Tickets', value: counts.ticketCount, icon: 'fa-life-ring', color: 'text-brand-400 bg-brand-500/15' }
    ] %>
    <% stats.forEach(s => { %>
      <div class="glass-card rounded-xl p-4">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-2 <%= s.color %>">
          <i class="fas <%= s.icon %>"></i>
        </div>
        <p class="text-2xl font-bold"><%= s.value %></p>
        <p class="text-xs text-surface-500"><%= s.label %></p>
      </div>
    <% }) %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="glass-card rounded-xl p-5">
      <h2 class="text-lg font-semibold mb-4">Management</h2>
      <div class="space-y-2">
        <a href="/admin/promo-codes" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-800/50 transition-colors">
          <div class="w-9 h-9 rounded-lg bg-green-500/15 flex items-center justify-center">
            <i class="fas fa-tag text-green-400"></i>
          </div>
          <div>
            <p class="text-sm font-medium">Promo Codes</p>
            <p class="text-xs text-surface-500">Create and manage discount codes</p>
          </div>
        </a>
        <a href="/admin/admins" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-800/50 transition-colors">
          <div class="w-9 h-9 rounded-lg bg-yellow-500/15 flex items-center justify-center">
            <i class="fas fa-shield-alt text-yellow-400"></i>
          </div>
          <div>
            <p class="text-sm font-medium">Admins</p>
            <p class="text-xs text-surface-500">Promote or demote site admins</p>
          </div>
        </a>
        <a href="/admin/support" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-800/50 transition-colors">
          <div class="w-9 h-9 rounded-lg bg-brand-500/15 flex items-center justify-center">
            <i class="fas fa-life-ring text-brand-400"></i>
          </div>
          <div>
            <p class="text-sm font-medium">Support Queue</p>
            <p class="text-xs text-surface-500">View all open support tickets</p>
          </div>
        </a>
      </div>
    </div>

    <div class="glass-card rounded-xl p-5">
      <h2 class="text-lg font-semibold mb-4">Recent Users</h2>
      <div class="space-y-2">
        <% recentUsers.forEach(u => { %>
          <div class="flex items-center gap-3 py-1.5">
            <% if (u.avatar) { %>
              <img src="https://cdn.discordapp.com/avatars/<%= u.discord_id %>/<%= u.avatar %>.png?size=32" alt="" class="w-8 h-8 rounded-full">
            <% } else { %>
              <div class="w-8 h-8 rounded-full bg-surface-700 flex items-center justify-center text-xs font-bold">
                <%= u.username.charAt(0).toUpperCase() %>
              </div>
            <% } %>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate"><%= u.global_name || u.username %></p>
              <p class="text-xs text-surface-500">Joined <%= new Date(u.created_at).toLocaleDateString() %></p>
            </div>
            <% if (u.is_admin) { %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-yellow-500/20 text-yellow-400">Admin</span>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="glass-card rounded-xl p-5 lg:col-span-2">
      <h2 class="text-lg font-semibold mb-4">Recent Subscriptions</h2>
      <% if (subscriptions.length === 0) { %>
        <p class="text-surface-500 text-sm">No subscriptions yet.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs text-surface-500 border-b border-surface-700/50">
                <th class="py-2 pr-4">Team</th>
                <th class="py-2 pr-4">Plan</th>
                <th class="py-2 pr-4">Status</th>
                <th class="py-2">Updated</th>
              </tr>
            </thead>
            <tbody>
              <% subscriptions.forEach(sub => { %>
                <tr class="border-b border-surface-800/50">
                  <td class="py-2 pr-4"><%= sub.team_name || 'Unknown team' %></td>
                  <td class="py-2 pr-4"><%= getPlan(sub.plan).name %></td>
                  <td class="py-2 pr-4"><span class="px-2 py-0.5 rounded-full text-xs <%= sub.status === 'active' ? 'bg-green-500/20 text-green-400' : 'bg-surface-800 text-surface-400' %>"><%= sub.status %></span></td>
                  <td class="py-2 text-surface-500"><%= new Date(sub.updated_at).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
