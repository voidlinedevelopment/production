<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Overlay</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 100%;
      height: 100%;
      background: transparent !important;
      overflow: hidden;
    }
    body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    #bar {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      min-height: 80px;
      padding: 18px 32px;
      background: linear-gradient(90deg, rgba(13, 17, 23, 0.92), rgba(13, 17, 23, 0.6));
      border-top: 3px solid #4c6ef5;
      display: none;
      align-items: center;
    }
    #text {
      color: #ffffff;
      font-size: 40px;
      font-weight: 700;
      line-height: 1.2;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
      letter-spacing: 0.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
    }
  </style>
</head>
<body>
  <div id="bar"><div id="text"></div></div>

  <script src="https://cdn.socket.io/4.7.4/socket.io.min.js"></script>
  <script>
    const connId = '<%= connId %>';
    const textEl = document.getElementById('text');
    const barEl = document.getElementById('bar');

    function setText(t) {
      textEl.textContent = t || '';
      barEl.style.display = (t && t.trim()) ? 'flex' : 'none';
    }

    setText('');

    const socket = io();
    socket.on('connect', () => {
      socket.emit('join-overlay', { connId });
    });
    socket.on('overlay-text', (data) => {
      setText(data.text);
    });
  </script>
</body>
</html>
