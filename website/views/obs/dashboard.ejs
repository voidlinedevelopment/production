<div class="max-w-7xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <a href="/teams/<%= team.id %>" class="text-surface-400 hover:text-white text-sm inline-flex items-center gap-1 mb-4">
        <i class="fas fa-arrow-left"></i> Back to Team
      </a>
      <h1 class="text-2xl font-bold">OBS Control</h1>
      <p class="text-surface-400 mt-1">Monitor and control your OBS connections.</p>
    </div>
  </div>

  <% if (connections.length === 0) { %>
    <div class="glass-card rounded-xl p-12 text-center max-w-lg mx-auto">
      <div class="w-16 h-16 rounded-full bg-purple-500/15 flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-desktop text-purple-400 text-2xl"></i>
      </div>
      <h3 class="text-xl font-semibold mb-2">No OBS Connections</h3>
      <p class="text-surface-400 mb-6">Add an OBS connection to start controlling your stream.</p>
      <a href="/obs/<%= team.id %>/connections" class="btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-medium">
        <i class="fas fa-plus"></i> Add Connection
      </a>
    </div>
  <% } else { %>
    <% connections.forEach(conn => { %>
      <div class="glass-card rounded-xl p-6 mb-5" id="obs-conn-<%= conn.id %>">
        <div class="flex items-center justify-between mb-5">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-600/20 flex items-center justify-center">
              <i class="fas fa-desktop text-purple-400 text-xl"></i>
            </div>
            <div>
              <h3 class="text-lg font-semibold"><%= conn.name %></h3>
              <p class="text-sm text-surface-400"><%= conn.host %>:<%= conn.port %></p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <% if (conn.agent_token) { %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-surface-800 text-surface-400 obs-agent-status" data-conn-id="<%= conn.id %>">
                Agent offline
              </span>
            <% } %>
            <span class="status-dot <%= conn.status === 'connected' ? 'status-online' : 'status-offline' %>"></span>
            <span class="text-sm font-medium <%= conn.status === 'connected' ? 'text-green-400' : 'text-surface-500' %> obs-status-text" data-conn-id="<%= conn.id %>">
              <%= conn.status === 'connected' ? 'Connected' : 'Disconnected' %>
            </span>
            <button onclick="connectOBS(<%= conn.id %>, '<%= conn.host %>', <%= conn.port %>, '<%= conn.password || '' %>')"
              class="px-3 py-1.5 rounded-lg text-xs font-medium bg-brand-600 hover:bg-brand-500 text-white transition-colors obs-connect-btn" data-conn-id="<%= conn.id %>">
              <%= conn.status === 'connected' ? 'Disconnect' : 'Connect' %>
            </button>
            <button onclick="togglePreview(<%= conn.id %>)"
              class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-800 hover:bg-surface-700 text-surface-300 transition-colors">
              <i class="fas fa-eye mr-1"></i>Preview
            </button>
          </div>
        </div>

        <div id="obs-preview-<%= conn.id %>" class="hidden mb-5">
          <div class="relative bg-black rounded-lg overflow-hidden" style="aspect-ratio: 16/9;">
            <video id="obs-preview-video-<%= conn.id %>" autoplay muted playsinline
              class="hidden w-full h-full object-contain"></video>
            <img id="obs-preview-img-<%= conn.id %>" src="" alt="Preview"
              class="w-full h-full object-contain">
            <p id="obs-preview-msg-<%= conn.id %>" class="absolute inset-0 flex items-center justify-center text-surface-500 text-sm">Waiting for preview...</p>
          </div>
        </div>

        <div class="glass-card rounded-lg p-4 mb-5">
          <h4 class="text-sm font-semibold text-surface-300 mb-3">Text Overlay</h4>
          <p class="text-xs text-surface-500 mb-3">Shows a lower-third bar on the OBS stream (requires the OBS Agent + OBS browser sources).</p>
          <div class="flex items-center gap-2">
            <input id="overlay-text-<%= conn.id %>" type="text" value="<%= conn.overlay_text || '' %>"
              placeholder="Text to show on stream"
              class="flex-1 bg-surface-800 border border-surface-700 rounded-lg px-3 py-2 text-sm text-white placeholder-surface-600 focus:outline-none focus:border-brand-500">
            <button onclick="setOverlay(<%= conn.id %>, true)"
              class="px-3 py-2 rounded-lg text-xs font-medium bg-brand-600 hover:bg-brand-500 text-white transition-colors">Show</button>
            <button onclick="setOverlay(<%= conn.id %>, false)"
              class="px-3 py-2 rounded-lg text-xs font-medium bg-surface-800 hover:bg-surface-700 text-surface-300 transition-colors">Hide</button>
          </div>
        </div>

        <div id="obs-controls-<%= conn.id %>" class="<%= conn.status !== 'connected' ? 'hidden' : '' %>">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
            <div class="glass-card rounded-lg p-3 text-center">
              <p class="text-xs text-surface-500 mb-1">Current Scene</p>
              <p class="font-semibold text-sm obs-scene" data-conn-id="<%= conn.id %>">--</p>
            </div>
            <div class="glass-card rounded-lg p-3 text-center">
              <p class="text-xs text-surface-500 mb-1">Stream</p>
              <p class="font-semibold text-sm obs-stream-status" data-conn-id="<%= conn.id %>">Not Streaming</p>
            </div>
            <div class="glass-card rounded-lg p-3 text-center">
              <p class="text-xs text-surface-500 mb-1">Recording</p>
              <p class="font-semibold text-sm obs-recording-status" data-conn-id="<%= conn.id %>">Not Recording</p>
            </div>
            <div class="glass-card rounded-lg p-3 text-center">
              <p class="text-xs text-surface-500 mb-1">FPS</p>
              <p class="font-semibold text-sm obs-fps" data-conn-id="<%= conn.id %>">--</p>
            </div>
          </div>

          <div class="mb-5">
            <h4 class="text-sm font-semibold text-surface-300 mb-3">Scenes</h4>
            <div class="flex flex-wrap gap-2 obs-scenes-container" data-conn-id="<%= conn.id %>">
              <p class="text-surface-500 text-sm">Connect to see scenes</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            <button onclick="obsCommand(<%= conn.id %>, 'startStream')" class="px-4 py-2 rounded-lg bg-red-500/15 hover:bg-red-500/25 text-red-400 text-sm font-medium transition-colors">
              <i class="fas fa-broadcast-tower mr-1"></i> Start Stream
            </button>
            <button onclick="obsCommand(<%= conn.id %>, 'stopStream')" class="px-4 py-2 rounded-lg bg-surface-800 hover:bg-surface-700 text-sm font-medium transition-colors">
              <i class="fas fa-stop mr-1"></i> Stop Stream
            </button>
            <button onclick="obsCommand(<%= conn.id %>, 'startRecording')" class="px-4 py-2 rounded-lg bg-surface-800 hover:bg-surface-700 text-sm font-medium transition-colors">
              <i class="fas fa-circle text-red-400 mr-1"></i> Record
            </button>
            <button onclick="obsCommand(<%= conn.id %>, 'stopRecording')" class="px-4 py-2 rounded-lg bg-surface-800 hover:bg-surface-700 text-sm font-medium transition-colors">
              <i class="fas fa-stop-circle mr-1"></i> Stop Record
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<script src="https://cdn.socket.io/4.7.4/socket.io.min.js"></script>
<script>
  const socket = io();
  const teamId = '<%= team.id %>';
  socket.emit('join-team', teamId);

  function connectOBS(connId, host, port, password) {
    socket.emit('obs-connect', { teamId, connId, host, port, password });
  }

  function obsCommand(connId, command) {
    socket.emit('obs-command', { teamId, connId, command });
  }

  function switchScene(connId, sceneName) {
    socket.emit('obs-command', { teamId, connId, command: 'switchScene', scene: sceneName });
  }

  socket.on('obs-status', (data) => {
    const statusTexts = document.querySelectorAll(`.obs-status-text[data-conn-id="${data.connId}"]`);
    statusTexts.forEach(el => {
      el.textContent = data.connected ? 'Connected' : 'Disconnected';
      el.className = `text-sm font-medium ${data.connected ? 'text-green-400' : 'text-surface-500'}`;
    });

    const controls = document.getElementById(`obs-controls-${data.connId}`);
    if (controls) {
      controls.classList.toggle('hidden', !data.connected);
    }

    const btns = document.querySelectorAll(`.obs-connect-btn[data-conn-id="${data.connId}"]`);
    btns.forEach(el => {
      el.textContent = data.connected ? 'Disconnect' : 'Connect';
    });
  });

  socket.on('obs-agent-status', (data) => {
    const els = document.querySelectorAll(`.obs-agent-status[data-conn-id="${data.connId}"]`);
    els.forEach(el => {
      el.textContent = data.online ? 'Agent online' : 'Agent offline';
      el.className = `text-xs px-2 py-0.5 rounded-full ${data.online ? 'bg-green-500/20 text-green-400' : 'bg-surface-800 text-surface-400'} obs-agent-status`;
    });
  });

  socket.on('obs-preview', (data) => {
    const img = document.getElementById(`obs-preview-img-${data.connId}`);
    const msg = document.getElementById(`obs-preview-msg-${data.connId}`);
    if (img && data.image) {
      const src = data.image.startsWith('data:') ? data.image : `data:image/jpeg;base64,${data.image}`;
      img.src = src;
      if (msg) msg.classList.add('hidden');
    }
  });

  const previewVideo = {};

  function previewQueueAppend(st, buf) {
    if (st.buffer && !st.buffer.updating) {
      try { st.buffer.appendBuffer(buf); } catch (e) {}
    } else {
      st.queue.push(buf);
    }
  }

  socket.on('obs-preview-video', (data) => {
    let st = previewVideo[data.connId];
    if (!st || data.streamId !== st.streamId) {
      if (st && st.ms && st.ms.readyState !== 'closed') {
        try { st.ms.endOfStream(); } catch (e) {}
        URL.revokeObjectURL(st.url);
      }
      st = previewVideo[data.connId] = { streamId: data.streamId, queue: [], ms: null, buffer: null, url: null };
      const video = document.getElementById(`obs-preview-video-${data.connId}`);
      if (video && window.MediaSource) {
        const ms = new MediaSource();
        st.ms = ms;
        st.url = URL.createObjectURL(ms);
        video.src = st.url;
        video.play().catch(() => {});
        ms.addEventListener('sourceopen', () => {
          try {
            st.buffer = ms.addSourceBuffer('video/webm;codecs=vp8');
          } catch (e) {
            try { st.buffer = ms.addSourceBuffer('video/webm'); } catch (e2) { st.buffer = null; }
          }
          if (st.buffer) {
            st.buffer.addEventListener('updateend', () => {
              if (st.queue.length && !st.buffer.updating) {
                st.buffer.appendBuffer(st.queue.shift());
              }
            });
            while (st.queue.length && !st.buffer.updating) {
              st.buffer.appendBuffer(st.queue.shift());
            }
          }
        });
      }
    }
    const cur = previewVideo[data.connId];
    previewQueueAppend(cur, new Uint8Array(data.data));
  });

  function previewStop(connId) {
    const st = previewVideo[connId];
    if (st) {
      if (st.ms && st.ms.readyState !== 'closed') {
        try { st.ms.endOfStream(); } catch (e) {}
      }
      if (st.url) URL.revokeObjectURL(st.url);
    }
    delete previewVideo[connId];
    const video = document.getElementById(`obs-preview-video-${connId}`);
    if (video) { video.pause(); video.removeAttribute('src'); video.load(); }
  }

  socket.on('obs-preview-live', (data) => {
    const connId = data.connId;
    const video = document.getElementById(`obs-preview-video-${connId}`);
    const img = document.getElementById(`obs-preview-img-${connId}`);
    const msg = document.getElementById(`obs-preview-msg-${connId}`);
    if (data.enabled) {
      if (video) video.classList.remove('hidden');
      if (img) img.classList.add('hidden');
      if (msg) msg.classList.add('hidden');
    } else {
      previewStop(connId);
      if (video) video.classList.add('hidden');
      if (img) img.classList.remove('hidden');
      if (msg) {
        msg.classList.remove('hidden');
        msg.textContent = data.error || 'Waiting for preview...';
      }
    }
  });

  function setOverlay(connId, enabled) {
    const text = document.getElementById(`overlay-text-${connId}`).value;
    socket.emit('overlay-set', { connId, text, enabled });
  }

  function togglePreview(connId) {
    const wrap = document.getElementById(`obs-preview-${connId}`);
    const enable = wrap.classList.contains('hidden');
    socket.emit('obs-preview-control', { connId, enabled: enable });
    wrap.classList.toggle('hidden');
    if (!enable) previewStop(connId);
  }

  socket.on('obs-error', (data) => {
    alert('OBS connection failed: ' + data.error);
    console.error('OBS connect error:', data.error);
  });

  socket.on('obs-scene', (data) => {
    const els = document.querySelectorAll(`.obs-scene[data-conn-id="${data.connId}"]`);
    els.forEach(el => el.textContent = data.scene);

    const container = document.querySelector(`.obs-scenes-container[data-conn-id="${data.connId}"]`);
    if (container && data.scenes) {
      container.innerHTML = data.scenes.map(scene =>
        `<button onclick="switchScene(${data.connId}, '${scene}')"
          class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
          ${scene === data.scene ? 'bg-brand-600 text-white' : 'bg-surface-800 hover:bg-surface-700 text-surface-300'}">
          ${scene}
        </button>`
      ).join('');
    }
  });

  socket.on('obs-stream-status', (data) => {
    const els = document.querySelectorAll(`.obs-stream-status[data-conn-id="${data.connId}"]`);
    els.forEach(el => {
      el.textContent = data.streaming ? 'LIVE' : 'Not Streaming';
      el.className = `font-semibold text-sm ${data.streaming ? 'text-red-400' : ''}`;
    });
  });

  socket.on('obs-recording-status', (data) => {
    const els = document.querySelectorAll(`.obs-recording-status[data-conn-id="${data.connId}"]`);
    els.forEach(el => {
      el.textContent = data.recording ? 'Recording' : 'Not Recording';
      el.className = `font-semibold text-sm ${data.recording ? 'text-red-400' : ''}`;
    });
  });

  socket.on('obs-stats', (data) => {
    const els = document.querySelectorAll(`.obs-fps[data-conn-id="${data.connId}"]`);
    els.forEach(el => el.textContent = data.fps || '--');
  });
</script>
