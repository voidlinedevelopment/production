<div class="max-w-5xl mx-auto">
  <div class="mb-8">
    <a href="/" class="text-surface-400 hover:text-white text-sm inline-flex items-center gap-1 mb-4">
      <i class="fas fa-arrow-left"></i> Back to Admin
    </a>
    <h1 class="text-2xl font-bold">Promo Codes</h1>
    <p class="text-surface-400 mt-1">Create discount codes customers can apply at checkout.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="rounded-xl p-4 mb-6 border border-red-500/30 bg-red-500/10 text-red-300 text-sm">
      <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
    </div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="rounded-xl p-4 mb-6 border border-green-500/30 bg-green-500/10 text-green-300 text-sm">
      <i class="fas fa-check-circle mr-2"></i><%= success %>
    </div>
  <% } %>

  <form method="POST" action="/promo-codes" class="glass-card rounded-xl p-6 mb-8">
    <h2 class="text-lg font-semibold mb-4">Create Promo Code</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-surface-300 mb-2">Code</label>
        <input type="text" name="code" required maxlength="32" placeholder="SUMMER20"
          class="w-full bg-surface-900 border border-surface-700 rounded-lg px-4 py-2.5 text-white uppercase placeholder-surface-600 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors">
      </div>
      <div>
        <label class="block text-sm font-medium text-surface-300 mb-2">Percent Off</label>
        <input type="number" name="percent_off" required min="1" max="100" value="20"
          class="w-full bg-surface-900 border border-surface-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors">
      </div>
      <div>
        <label class="block text-sm font-medium text-surface-300 mb-2">Max Uses <span class="text-surface-600">(blank = unlimited)</span></label>
        <input type="number" name="max_uses" min="1" placeholder="Unlimited"
          class="w-full bg-surface-900 border border-surface-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors">
      </div>
    </div>
    <button type="submit" class="btn-primary px-6 py-2.5 rounded-xl text-white font-medium text-sm mt-4">
      <i class="fas fa-plus mr-2"></i>Create Code
    </button>
  </form>

  <% if (codes.length === 0) { %>
    <div class="glass-card rounded-xl p-8 text-center">
      <i class="fas fa-tag text-surface-600 text-3xl mb-3"></i>
      <p class="text-surface-400">No promo codes yet.</p>
    </div>
  <% } else { %>
    <div class="glass-card rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-surface-500 border-b border-surface-700/50">
            <th class="py-3 px-4">Code</th>
            <th class="py-3 px-4">Discount</th>
            <th class="py-3 px-4">Usage</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Created By</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% codes.forEach(code => { %>
            <tr class="border-b border-surface-800/50">
              <td class="py-3 px-4 font-mono font-medium"><%= code.code %></td>
              <td class="py-3 px-4"><%= code.percent_off %>% off</td>
              <td class="py-3 px-4 text-surface-500">
                <%= code.used_count %><%= code.max_uses ? ' / ' + code.max_uses : '' %>
              </td>
              <td class="py-3 px-4">
                <span class="px-2 py-0.5 rounded-full text-xs <%= code.active ? 'bg-green-500/20 text-green-400' : 'bg-surface-800 text-surface-400' %>">
                  <%= code.active ? 'Active' : 'Disabled' %>
                </span>
              </td>
              <td class="py-3 px-4 text-surface-500"><%= code.created_by_name || '—' %></td>
              <td class="py-3 px-4">
                <div class="flex justify-end gap-2">
                  <form method="POST" action="/promo-codes/<%= code.id %>/toggle">
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-surface-800 hover:bg-surface-700 text-xs font-medium transition-colors">
                      <i class="fas <%= code.active ? 'fa-pause' : 'fa-play' %> mr-1"></i><%= code.active ? 'Disable' : 'Enable' %>
                    </button>
                  </form>
                  <form method="POST" action="/promo-codes/<%= code.id %>/delete" onsubmit="return confirm('Delete this promo code?')">
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-500/15 hover:bg-red-500/25 text-red-400 text-xs font-medium transition-colors">
                      <i class="fas fa-trash mr-1"></i>Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
