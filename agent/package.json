{
  "name": "production-obs-agent",
  "version": "1.2.3",
  "description": "Production OBS Agent - connects your OBS Studio to the Production platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.production.obsagent",
    "productName": "Production OBS Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "obs.js",
      "socket.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://production.ocrp.cc/downloads/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "obs-websocket-js": "^5.0.6",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
