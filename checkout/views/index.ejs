<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Production</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: { 400: '#748ffc', 500: '#5c7cfa', 600: '#4c6ef5', 700: '#4263eb' },
            surface: {
              500: '#adb5bd', 600: '#868e96', 700: '#495057', 800: '#343a40',
              900: '#212529', 950: '#0d1117'
            }
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    body { background-color: #0d1117; color: #e6edf3; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    .glass-card { background: rgba(22, 27, 34, 0.6); border: 1px solid rgba(48, 54, 61, 0.4); }
    .btn-primary { background: linear-gradient(135deg, #4c6ef5, #3b5bdb); transition: all .2s ease; }
    .btn-primary:hover { background: linear-gradient(135deg, #5c7cfa, #4263eb); box-shadow: 0 4px 15px rgba(76, 110, 245, .4); }
    .btn-primary:disabled { opacity: .6; cursor: not-allowed; box-shadow: none; }
    .field-input {
      width: 100%; background: #0d1117; border: 1px solid #343a40; border-radius: .75rem;
      padding: .65rem 1rem; color: #e6edf3; font-size: .875rem; transition: all .2s ease;
    }
    .field-input:focus { outline: none; border-color: #5c7cfa; box-shadow: 0 0 0 1px #5c7cfa; }
    .field-input::placeholder { color: #495057; }
  </style>
</head>
<body class="min-h-screen antialiased">
  <div class="max-w-5xl mx-auto px-6 py-10">
    <div class="flex items-center gap-2 mb-8">
      <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center">
        <i class="fa-solid fa-tower-broadcast text-white text-sm"></i>
      </div>
      <span class="text-lg font-bold" style="background:linear-gradient(135deg,#748ffc,#5c7cfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Production</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div>
        <h1 class="text-2xl font-bold mb-2">Subscribe to <%= plan.name %></h1>
        <p class="text-surface-500 text-sm mb-6">Team: <span class="text-surface-300"><%= team.name %></span></p>

        <div class="glass-card rounded-xl p-6 mb-6">
          <div class="flex items-center justify-between mb-2">
            <div>
              <h2 class="text-lg font-semibold"><%= plan.name %> Plan</h2>
              <p class="text-sm text-surface-500"><%= plan.blurb %></p>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold"><%= plan.priceLabel %></p>
              <p class="text-xs text-surface-500">per month</p>
            </div>
          </div>
          <ul class="mt-4 space-y-2">
            <% plan.features.forEach(f => { %>
              <li class="flex items-start gap-2 text-sm">
                <i class="fa-solid fa-check text-green-400 mt-0.5"></i>
                <span class="text-surface-300"><%= f %></span>
              </li>
            <% }) %>
          </ul>
        </div>

        <a href="<%= billingUrl %>/?team=<%= team.id %>" class="text-sm text-brand-400 hover:text-brand-300">
          <i class="fa-solid fa-arrow-left mr-1"></i> Back to billing
        </a>
      </div>

      <div class="glass-card rounded-xl p-6 h-fit">
        <h2 class="text-lg font-semibold mb-4">Payment details</h2>

        <div id="checkout-error"></div>

        <div class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-surface-400 mb-1.5">Email</label>
            <div id="contact-details-element" class="bg-surface-900 border border-surface-700 rounded-xl p-3"></div>
          </div>

          <div>
            <label class="block text-sm font-medium text-surface-400 mb-1.5">Promo code</label>
            <div class="flex gap-2">
              <input type="text" id="promo-input" class="field-input" placeholder="Enter a promo code" autocomplete="off">
              <button type="button" id="promo-apply" class="btn-primary px-4 rounded-xl text-white text-sm font-medium flex-shrink-0">
                Apply
              </button>
            </div>
            <p id="promo-status" class="text-xs mt-1.5 text-surface-500"></p>
          </div>

          <div>
            <label class="block text-sm font-medium text-surface-400 mb-1.5">Payment method</label>
            <div id="payment-element" class="bg-surface-900 border border-surface-700 rounded-xl p-3"></div>
          </div>

          <div class="border-t border-surface-700/60 pt-4 space-y-2 text-sm">
            <div class="flex justify-between text-surface-500">
              <span>Subtotal</span>
              <span id="line-total"><%= plan.priceLabel %></span>
            </div>
            <div class="flex justify-between text-green-400" id="discount-row" style="display:none;">
              <span>Discount</span>
              <span id="discount-amount">-$0.00</span>
            </div>
            <div class="flex justify-between text-base font-bold pt-1">
              <span>Total</span>
              <span id="total-amount"><%= plan.priceLabel %></span>
            </div>
          </div>

          <button type="submit" id="pay-button" class="btn-primary w-full px-6 py-3.5 rounded-xl text-white font-semibold text-sm flex items-center justify-center gap-2">
            <i class="fa-solid fa-lock text-xs"></i>
            <span>Subscribe to <%= plan.name %> - <%= plan.priceLabel %>/month</span>
          </button>
          <p id="pay-error" class="text-red-400 text-sm text-center"></p>

          <p class="text-xs text-surface-500 flex items-center gap-1.5">
            <i class="fa-solid fa-lock text-surface-600"></i>
            Secured by Stripe. Payments are billed monthly and can be managed from your billing page.
          </p>
        </div>
      </div>
    </div>
  </div>

  <script src="https://js.stripe.com/dahlia/stripe.js"></script>
  <script>
    const stripe = Stripe('<%= publishableKey %>');
    const appearance = {
      theme: 'night',
      variables: {
        colorPrimary: '#5c7cfa',
        colorPrimaryText: '#ffffff',
        colorBackground: '#161b22',
        colorText: '#e6edf3',
        colorTextSecondary: '#adb5bd',
        colorBorder: '#30363d',
        colorDanger: '#f87171',
        colorIcon: '#adb5bd',
        colorIconHover: '#5c7cfa',
        fontFamily: 'Segoe UI, Roboto, Helvetica, Arial, sans-serif',
        borderRadius: '12px'
      }
    };

    const checkout = stripe.initCheckoutElementsSdk({
      clientSecret: '<%= clientSecret %>',
      elementsOptions: { appearance },
      <% if (ownerEmail) { %>defaultValues: { email: '<%= ownerEmail %>' },<% } %>
    });

    let actions = null;

    function updateSummary(session) {
      const t = session.total;
      if (!t) return;
      document.getElementById('line-total').textContent = t.subtotal ? t.subtotal.amount : (t.total ? t.total.amount : '');
      const discount = t.discount ? t.discount.minorUnitsAmount : 0;
      const row = document.getElementById('discount-row');
      if (discount > 0) {
        row.style.display = 'flex';
        document.getElementById('discount-amount').textContent = '-' + (t.discount.amount || '');
      } else {
        row.style.display = 'none';
      }
      document.getElementById('total-amount').textContent = t.total ? t.total.amount : '';
    }

    checkout.on('change', (session) => updateSummary(session));

    async function initialize() {
      const result = await checkout.loadActions();
      if (result.type === 'error') throw result.error;
      actions = result.actions;
      updateSummary(await actions.getSession());
      document.getElementById('pay-button').disabled = false;
    }

    const paymentElement = checkout.createPaymentElement({ layout: 'tabs' });
    paymentElement.mount('#payment-element');

    const contactDetails = checkout.createContactDetailsElement();
    contactDetails.mount('#contact-details-element');

    document.getElementById('promo-apply').addEventListener('click', async () => {
      const input = document.getElementById('promo-input');
      const status = document.getElementById('promo-status');
      const code = input.value.trim();
      if (!actions) { status.textContent = 'Checkout is still loading, please wait.'; return; }
      if (!code) { status.textContent = ''; return; }
      status.className = 'text-xs mt-1.5 text-surface-500';
      status.textContent = 'Applying promo code...';
      const res = await actions.applyPromotionCode(code);
      if (res && res.error) {
        status.className = 'text-xs mt-1.5 text-red-400';
        status.textContent = res.error.message;
      } else {
        status.className = 'text-xs mt-1.5 text-green-400';
        status.textContent = 'Promo code applied.';
        input.value = '';
      }
    });

    document.getElementById('pay-button').addEventListener('click', async (e) => {
      e.preventDefault();
      const btn = e.currentTarget;
      const errEl = document.getElementById('pay-error');
      if (!actions) { errEl.textContent = 'Checkout is still loading, please wait.'; return; }
      btn.disabled = true;
      btn.querySelector('span').textContent = 'Processing...';
      errEl.textContent = '';
      const res = await actions.confirm();
      if (res && res.error) {
        errEl.textContent = res.error.message;
        btn.querySelector('span').textContent = 'Subscribe to <%= plan.name %> - <%= plan.priceLabel %>/month';
        btn.disabled = false;
      }
    });

    initialize().catch((err) => {
      document.getElementById('checkout-error').innerHTML =
        '<p class="text-red-400 text-sm mb-3">Could not load the payment form: ' +
        (err && err.message ? err.message : err) + '</p>';
    });
  </script>
</body>
</html>
