<div class="max-w-5xl mx-auto">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Run Query</h1>
    <p class="text-surface-400 mt-1">Execute raw SQL against the database. SELECT / PRAGMA / WITH queries return results.</p>
  </div>

  <form method="POST" action="/query" class="mb-6">
    <textarea name="sql" rows="6" spellcheck="false" autocomplete="off"
      class="w-full bg-surface-900 border border-surface-700 rounded-xl px-4 py-3 text-white font-mono text-sm placeholder-surface-600 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors scrollbar-thin"
      placeholder="SELECT * FROM teams LIMIT 100;"><%= sql %></textarea>
    <div class="flex justify-end mt-3">
      <button type="submit" class="btn-primary px-6 py-2.5 rounded-xl text-white font-medium text-sm">
        <i class="fas fa-play mr-2"></i>Run Query
      </button>
    </div>
  </form>

  <% if (message) { %>
    <div class="rounded-xl p-4 mb-6 border border-brand-500/30 bg-brand-500/10 text-brand-300 text-sm">
      <i class="fas fa-info-circle mr-2"></i><%= message %>
    </div>
  <% } %>

  <% if (columns) { %>
    <div class="glass-card rounded-xl overflow-hidden">
      <div class="overflow-x-auto scrollbar-thin">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-surface-500 border-b border-surface-700/50">
              <% columns.forEach(c => { %>
                <th class="py-3 px-4 whitespace-nowrap"><%= c %></th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(row => { %>
              <tr class="border-b border-surface-800/50 hover:bg-surface-900/40">
                <% columns.forEach(c => { %>
                  <td class="py-2 px-4 max-w-xs truncate text-surface-300">
                    <%= row[c] == null ? '<span class="text-surface-600">NULL</span>' : row[c] %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>
