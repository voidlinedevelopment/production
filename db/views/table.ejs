<div class="max-w-7xl mx-auto">
  <div class="mb-8">
    <a href="/" class="text-surface-400 hover:text-white text-sm inline-flex items-center gap-1 mb-4">
      <i class="fas fa-arrow-left"></i> Back to Tables
    </a>
    <h1 class="text-2xl font-bold font-mono"><%= table %></h1>
    <p class="text-surface-400 mt-1"><%= rows.length %> row(s) shown<% if (truncated) { %> (showing first 50)<% } %></p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="rounded-xl p-4 mb-6 border border-red-500/30 bg-red-500/10 text-red-300 text-sm">
      <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
    </div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="rounded-xl p-4 mb-6 border border-green-500/30 bg-green-500/10 text-green-300 text-sm">
      <i class="fas fa-check-circle mr-2"></i><%= success %>
    </div>
  <% } %>

  <div class="glass-card rounded-xl p-6 mb-8">
    <h2 class="text-lg font-semibold mb-4"><%= editRow ? 'Edit Row' : 'Add Row' %></h2>
    <form method="POST" action="/table/<%= encodeURIComponent(table) %>/<%= editRow ? 'update' : 'insert' %>" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <% if (editRow) { %>
        <input type="hidden" name="__rowid" value="<%= editRowId %>">
      <% } %>
      <% formCols.forEach(c => { %>
        <div>
          <label class="block text-sm font-medium text-surface-300 mb-1.5 truncate"><%= c.name %></label>
          <% const isNum = /INT|REAL|NUMERIC|DECIMAL|FLOAT|DOUBLE/i.test(c.type || ''); %>
          <input type="<%= isNum ? 'number' : 'text' %>" step="<%= isNum ? 'any' : undefined %>" name="<%= c.name %>"
            value="<%= editRow ? (editRow[c.name] == null ? '' : editRow[c.name]) : '' %>"
            placeholder="<%= c.type || 'text' %>"
            class="field-input">
        </div>
      <% }) %>
      <div class="flex items-end">
        <button type="submit" class="btn-primary px-6 py-2.5 rounded-xl text-white font-medium text-sm">
          <i class="fas <%= editRow ? 'fa-save' : 'fa-plus' %> mr-2"></i><%= editRow ? 'Save' : 'Add Row' %>
        </button>
      </div>
    </form>
  </div>

  <% if (rows.length === 0) { %>
    <div class="glass-card rounded-xl p-8 text-center">
      <i class="fas fa-inbox text-surface-600 text-3xl mb-3"></i>
      <p class="text-surface-400">No rows in this table.</p>
    </div>
  <% } else { %>
    <div class="glass-card rounded-xl overflow-hidden">
      <div class="overflow-x-auto scrollbar-thin">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-surface-500 border-b border-surface-700/50">
              <th class="py-3 px-4">Actions</th>
              <% columns.forEach(c => { %>
                <th class="py-3 px-4 whitespace-nowrap"><%= c.name %></th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(row => { %>
              <tr class="border-b border-surface-800/50 hover:bg-surface-900/40">
                <td class="py-2 px-4 whitespace-nowrap">
                  <div class="flex gap-2">
                    <a href="/table/<%= encodeURIComponent(table) %>?edit=<%= row.__rowid %>" class="px-2.5 py-1.5 rounded-lg bg-surface-800 hover:bg-surface-700 text-xs transition-colors" title="Edit">
                      <i class="fas fa-pen text-surface-400"></i>
                    </a>
                    <form method="POST" action="/table/<%= encodeURIComponent(table) %>/delete" onsubmit="return confirm('Delete this row?')">
                      <input type="hidden" name="rowid" value="<%= row.__rowid %>">
                      <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-red-500/15 hover:bg-red-500/25 text-xs transition-colors" title="Delete">
                        <i class="fas fa-trash text-red-400"></i>
                      </button>
                    </form>
                  </div>
                </td>
                <% columns.forEach(c => { %>
                  <td class="py-2 px-4 max-w-xs truncate text-surface-300">
                    <%= row[c.name] == null ? '<span class="text-surface-600">NULL</span>' : row[c.name] %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>
