<div class="max-w-5xl mx-auto">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Tables</h1>
    <p class="text-surface-400 mt-1">Browse and manage the production database.</p>
  </div>

  <% if (tables.length === 0) { %>
    <div class="glass-card rounded-xl p-8 text-center">
      <i class="fas fa-database text-surface-600 text-3xl mb-3"></i>
      <p class="text-surface-400">No tables found.</p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% tables.forEach(t => { %>
        <a href="/table/<%= encodeURIComponent(t.name) %>" class="glass-card rounded-xl p-4 flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-brand-600/15 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-table text-brand-400 text-sm"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-medium truncate"><%= t.name %></p>
            <p class="text-xs text-surface-500"><%= t.count %> row(s)</p>
          </div>
          <i class="fas fa-chevron-right text-surface-600 text-xs flex-shrink-0"></i>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
