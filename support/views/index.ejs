<div class="max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold">Support Portal</h1>
      <p class="text-surface-400 mt-1">How can we help?</p>
    </div>
    <a href="/tickets/new" class="btn-primary inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-white text-sm font-medium">
      <i class="fas fa-plus"></i>
      Open a Ticket
    </a>
  </div>

  <% if (isAdmin) { %>
    <div class="rounded-xl p-4 mb-6 border border-yellow-500/30 bg-yellow-500/10 text-yellow-300 text-sm">
      <i class="fas fa-shield-alt mr-2"></i>You are viewing the staff support queue.
    </div>
  <% } %>

  <div class="glass-card rounded-2xl p-6 mb-8">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div>
        <p class="text-sm text-surface-400">Your support tier</p>
        <p class="text-2xl font-bold mt-1"><%= tier.tier %> <span class="text-surface-500 text-sm font-medium">(<%= tier.planName %> plan)</span></p>
        <p class="text-sm text-surface-500 mt-2"><%= tier.responseTime %></p>
      </div>
      <div class="text-right">
        <p class="text-sm text-surface-400">Open tickets</p>
        <p class="text-3xl font-bold text-brand-400 mt-1"><%= openCount %></p>
      </div>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-4">Recent Tickets</h2>
  <% if (tickets.length === 0) { %>
    <div class="glass-card rounded-xl p-8 text-center">
      <i class="fas fa-ticket-alt text-surface-600 text-3xl mb-3"></i>
      <p class="text-surface-400 mb-4">You haven't opened any tickets yet.</p>
      <a href="/tickets/new" class="btn-primary inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white text-sm font-medium">
        <i class="fas fa-plus"></i> Open Your First Ticket
      </a>
    </div>
  <% } else { %>
    <div class="space-y-3">
      <% tickets.slice(0, 5).forEach(ticket => { %>
        <a href="/tickets/<%= ticket.id %>" class="glass-card rounded-xl p-4 flex items-center gap-4 block">
          <div class="w-10 h-10 rounded-lg bg-brand-600/15 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-ticket-alt text-brand-400 text-sm"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-medium truncate">#<%= ticket.id %> - <%= ticket.subject %></p>
            <p class="text-xs text-surface-500"><%= ticket.category %> &middot; <%= new Date(ticket.updated_at).toLocaleString() %></p>
          </div>
          <span class="px-2 py-0.5 rounded-full text-xs font-medium
            <%= ticket.status === 'closed' ? 'bg-surface-700 text-surface-400' : ticket.status === 'pending' ? 'bg-yellow-500/20 text-yellow-400' : 'bg-green-500/20 text-green-400' %>">
            <%= ticket.status %>
          </span>
        </a>
      <% }) %>
    </div>
    <a href="/tickets" class="text-brand-400 hover:text-brand-300 text-sm mt-4 inline-block">View all tickets</a>
  <% } %>
</div>
