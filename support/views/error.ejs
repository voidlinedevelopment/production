<div class="min-h-screen flex items-center justify-center px-6">
  <div class="max-w-md w-full text-center">
    <div class="w-14 h-14 rounded-xl bg-red-500/15 flex items-center justify-center mx-auto mb-4">
      <i class="fas fa-exclamation-triangle text-red-400 text-xl"></i>
    </div>
    <h1 class="text-2xl font-bold mb-2"><%= typeof title !== 'undefined' ? title : 'Error' %></h1>
    <p class="text-surface-400 mb-6"><%= message %></p>
    <a href="/" class="btn-primary inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-white text-sm font-medium">
      <i class="fas fa-arrow-left"></i> Back to Support
    </a>
  </div>
</div>
